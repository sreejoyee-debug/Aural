# AURAL Express API — production environment template
NODE_ENV=production
PORT=4000

# One or more permitted web-app origins, separated by commas. No trailing slash.
# Add your Vercel production URL and any preview URL you explicitly want to test.
CLIENT_ORIGIN=https://aural-ezwqpfl3j-sreejoyee-debug.vercel.app,https://app.your-aural-domain.com

# Supabase Dashboard → Connect → Session pooler. This is suitable for a
# persistent Express server hosted on an IPv4-only platform.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Dashboard → Project Settings → API. These names intentionally do
# not use VITE_: the values stay on the server and are read by src/server.ts.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR-PROJECT-PUBLISHABLE-KEY]

# OpenWeather Dashboard → API keys. Required only for weather endpoints.
OPENWEATHER_API_KEY=[YOUR-OPENWEATHER-API-KEY]
