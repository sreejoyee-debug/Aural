# Optional. Set this to the public URL of your deployed Express API.
# If omitted, AURAL fetches public Audius discovery data directly so song
# shelves and search still work when the API has not been deployed yet.
# Example: https://api.your-aural-domain.com/api
VITE_API_URL=

# Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR-PROJECT-PUBLISHABLE-KEY]
